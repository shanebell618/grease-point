// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum EquipmentStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
  OUT_OF_SERVICE
}

// SQLite has no native enum type, so Prisma stores EquipmentStatus as TEXT
// and only enforces the constraint at the Prisma Client/TypeScript layer,
// not via a DB CHECK constraint. Fine for this project's scope.
model Equipment {
  id            String          @id @default(cuid())
  name          String
  serialNumber  String          @unique
  vin           String?
  status        EquipmentStatus @default(ACTIVE)
  // Money as Float (not Decimal — unsupported on SQLite/Prisma) is a
  // pragmatic choice here; real money handling would use integer cents
  // or Postgres Decimal.
  purchasePrice Float?
  engineHours   Float?
  // Single hero-image URL for now; a multi-photo gallery + real upload
  // pipeline is a documented breadcrumb, not built yet — see
  // src/features/documents/README.md.
  photoUrl      String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

