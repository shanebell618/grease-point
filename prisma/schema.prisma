// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Feeds the in-memory mock Prisma client used by dataAccess/useCases tests
// (see src/lib/prisma/mockClient.ts) — no real database involved in tests.
generator dmmf {
  provider = "prisma-mock"
  output   = "../src/generated/dmmf.ts"
}

generator erd {
  provider = "prisma-erd-generator"
}

datasource db {
  provider = "sqlite"
}

enum EquipmentStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
  OUT_OF_SERVICE
}

model Equipment {
  id            String          @id @default(cuid())
  name          String
  vin           String?
  status        EquipmentStatus @default(ACTIVE)
  purchasePrice Float?
  operatingHours   Float?
  photoUrl      String?
  notes         String?
  maintenanceRecords MaintenanceRecord[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  WAITING_ON_PARTS
  COMPLETE
}

model MaintenanceRecord {
  id            String    @id @default(cuid())
  equipmentId   String
  equipment     Equipment @relation(fields: [equipmentId], references: [id])
  serviceDate   DateTime
  description   String
  status        MaintenanceStatus @default(SCHEDULED)
  completedAt   DateTime?
  cost          Float?
  nextDueHours  Float?
  nextDueDate   DateTime?
  createdAt     DateTime  @default(now())
}

